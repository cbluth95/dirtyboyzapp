# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=49000

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Email Settings
EMAIL_FROM=Dirty Boyz Sanitation <noreply@dirtyboyzsanitation.com>
EMAIL_TO=admin@dirtyboyzsanitation.com

# Application URL
APP_URL=http://127.0.0.1:49000

# ------------------------------------------------------------
# Firebase Client SDK (used in browser — safe to expose)
# ------------------------------------------------------------
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------
# Admin Setup — used by scripts/create-admin.js ONLY (server-side)
# Run: node scripts/create-admin.js
# Then REMOVE ADMIN_PASSWORD from this file — it is no longer needed.
# ------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
ADMIN_EMAIL=admin@dirtyboyzsanitation.com
ADMIN_PASSWORD=ChangeMe_StrongPassword123!
